# Private Tracker (PT) tracker and BitTorrent direct rules
# Routing policy: mihomo RULE-SET pt-direct -> DIRECT
#                  Shadowrocket RULE-SET pt-direct.txt -> Direct
#
# Purpose: Tracker announces and P2P transfers MUST be DIRECT to ensure connectability
# (green light port forwarding) and prevent account bans due to datacenter/proxy IP reporting.
# Web browsing, poster images, and torrent downloading live in pt-proxy.list.

# ---- Generic announce keyword (matches any tracker announce endpoint) ----
DOMAIN-KEYWORD,announce

# ---- Generic BitTorrent protocol infrastructure ----
DOMAIN-SUFFIX,bittorrent.com

# ---- M-Team (馒头) tracker endpoints ----
DOMAIN,tracker.m-team.cc
DOMAIN,tracker.m-team.io
DOMAIN,tracker.m-team.co
DOMAIN,tp.m-team.cc
DOMAIN,tp.m-team.io
DOMAIN,tp.m-team.co

